{
  "name": "@ai-verse/dashboard",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js test/*.test.mjs",
    "check": "npm run build && npm test",
    "mc1:bootstrap": "npm run build --silent && node dist/scripts/mc1/bootstrap.js",
    "mc1:preflight": "npm run build --silent && node dist/scripts/mc1/preflight.js",
    "mc1:proof": "npm run build --silent && node dist/scripts/mc1/proof.js",
    "mc1:local": "bash scripts/mc1/run-local.sh",
    "mc1:eligibility": "node scripts/mc1/eligibility.mjs",
    "mc1:local-model": "npm run build --silent && node scripts/mc1/local-model-proof.mjs",
    "mc2:bundle": "npx --yes esbuild@0.25.12 apps/web/src/personal-chat-ui.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/apps/web/personal-chat.bundle.js",
    "test:personal-browser": "node --test test/live-personal-chat-ui.browser.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
